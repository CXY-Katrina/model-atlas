  "cards": [
    {
      "dot": "emerald",
      "title": "主数据路径",
      "items": [
        "五路投影一次 GEMM 产生 Q/K/V/Qidx/Kidx（packed 9856 通道）",
        "Q/K 与 index Q/K 的 norm、partial RoPE、cache 量化写入在同一融合 kernel 完成",
        "主 attention 只对 Top-16 选中块内 token 做精确 causal GQA，每 query ≤2048 keys"
      ]
    },
    {
      "dot": "cyan",
      "title": "两套缓存",
      "items": [
        "主 KV cache：NVFP4，每 128 token 一页；page size == sparse block size",
        "Index K cache：key-only，每 token 一个 128 维向量，无 index V",
        "indexer 写 topk_indices_buffer，attend kernel 读回，二者不同步物化 selected KV"
      ]
    },
    {
      "dot": "orange",
      "title": "与 M3 的差异",
      "items": [
        "M3.1-Flash 全部 60 层为 sparse attention（M3 的 L0–L2 为 dense GQA）",
        "rope_theta = 1e7（M3 为 5e6）；NVFP4 KV 仅 SM100 MSA 后端支持"
      ]
    }
  ]
