  "cards": [
    {
      "dot": "cyan",
      "title": "为什么只要 32 个索引头",
      "items": [
        "索引头只负责“挑出重要的 2048 个 token”,不生成内容",
        "k 与 head 权重 w 由同一条 wk_weights_proj GEMM 产出(图中 k 边连向打分,w 以文字标注)",
        "softmax_scale = 128^(-1/2),再乘头数归一 32^(-1/2)"
      ]
    },
    {
      "dot": "amber",
      "title": "FP8 细节",
      "items": [
        "q 在投影后按 128 元素一组做 FP8 量化,scale 为 ue8m0 幂次",
        "k 在写入独立 key-only cache 时融合量化,不占 MLA 主 cache",
        "head 权重 w 在打分前折叠 q_scale / √128 / √32"
      ]
    },
    {
      "dot": "emerald",
      "title": "full 与 shared 的分工",
      "items": [
        "indexer_types 共 78 项:full 恰在 L0, L1, L5, L9, …, L77(21 层)",
        "checkpoint 权重索引证实:只有这 21 层有 indexer.* 权重",
        "shared 层跳过打分,直接读 buffer 中最近前驱 full 层的索引"
      ]
    }
  ]
