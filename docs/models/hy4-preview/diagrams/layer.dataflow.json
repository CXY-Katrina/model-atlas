  ],
  "flows": [
    { "id": "input-to-prea", "from": "layer-input", "to": "hc-pre-a", "label": "prepare_input", "classification": "规范化为 3D", "variant": "emphasis" },
    { "id": "prea-to-norm", "from": "hc-pre-a", "to": "input-norm", "label": "归约 · post 门", "classification": "4→1 通道", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [420, 200] },
    { "id": "norm-to-attn", "from": "input-norm", "to": "attn-sub", "label": "normalized", "classification": "子块输入", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [420, 314] },
    { "id": "attn-to-posta", "from": "attn-sub", "to": "hc-post-a", "label": "子块输出", "classification": "[T,6144]", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [420, 428] },
    { "id": "posta-to-prem", "from": "hc-post-a", "to": "hc-pre-m", "label": "[T,4,6144]", "classification": "4 通道散回", "variant": "emphasis", "labelAt": [423, 542] },
    { "id": "prem-to-postnorm", "from": "hc-pre-m", "to": "post-norm", "label": "归约 · post 门", "classification": "4→1 通道", "variant": "default", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [840, 428] },
    { "id": "postnorm-to-ffn", "from": "post-norm", "to": "ffn-sub", "label": "normalized", "classification": "子块输入", "variant": "default", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [840, 314] },
    { "id": "ffn-to-postm", "from": "ffn-sub", "to": "hc-post-m", "label": "子块输出", "classification": "[T,6144]", "variant": "default", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [840, 200] },
    { "id": "postm-to-out", "from": "hc-post-m", "to": "layer-out", "label": "[T,4,6144]", "classification": "层输出", "variant": "emphasis", "labelAt": [638, 200] }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "iHC 门控(hc_pre)",
      "items": [
        "flatten 到 [T,24576] 后 FP32 计算:rsqrt(mean(x²)+1e−5) · hc_fn(24576→8)",
        "pre = σ(·scale₀+base₀)+1e−6,通道加权和 y=Σ pre_i·x_i",
        "post = 2·σ(·scale₁+base₁)+1e−6 交给 hc_post;base 初始 −log 3 / 0"
      ]
    },
    {
      "dot": "emerald",
      "title": "两个子块只差 FFN",
      "items": [
        "所有 78 层的注意力子块同构:MLA + DSA + learnable sink + gated MLA",
        "L0 是 dense SwiGLU FFN(intermediate 18432)",
        "L1–L77 是 MoE:256 路由(top-8)+ 1 共享(moe 图展开)"
      ]
    },
    {
      "dot": "amber",
      "title": "残差去哪了",
      "items": [
        "单一大残差流不存在;残差就是 4 通道 hidden 本身",
        "hc_post:y[n,i,d] = post[n,i]·x[n,d] + residual[n,i,d]",
        "层间 residual=None,4 通道张量即残差载体;出口由 hc_head 合并"
      ]
    }
  ]
}
