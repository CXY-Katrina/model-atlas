    { "label": "FFN 子块" },
    { "label": "层输出" }
  ],
  "nodes": [
    { "id": "layer-input", "type": "external", "label": "层输入 hidden", "sublabel": "[T,6144] → 4 通道", "stage": 0, "row": 1, "width": 150 },
    { "id": "hc-pre-a", "type": "backend", "label": "hc_pre · attn", "sublabel": "RMS → hc_fn 24576→8 → σ 门 · 4→1", "stage": 1, "row": 0, "width": 180 },
    { "id": "input-norm", "type": "backend", "label": "input_layernorm", "sublabel": "RMSNorm · ε=1e−5", "stage": 1, "row": 1, "width": 170 },
    { "id": "attn-sub", "type": "backend", "label": "Attention 子块", "sublabel": "MLA + DSA · 见 dsa 两图", "stage": 1, "row": 2, "width": 180 },
    { "id": "hc-post-a", "type": "backend", "label": "hc_post · attn", "sublabel": "post·x + residual · 无参数", "stage": 1, "row": 3, "width": 180 },
    { "id": "hc-pre-m", "type": "backend", "label": "hc_pre · mlp", "sublabel": "RMS → hc_fn 24576→8 → σ 门 · 4→1", "stage": 2, "row": 3, "width": 180 },
    { "id": "post-norm", "type": "backend", "label": "post_attention_layernorm", "sublabel": "RMSNorm · ε=1e−5", "stage": 2, "row": 2, "width": 170 },
    { "id": "ffn-sub", "type": "backend", "label": "FFN 子块", "sublabel": "L0 dense 18432 · L1–77 MoE", "stage": 2, "row": 1, "width": 180 },
    { "id": "hc-post-m", "type": "backend", "label": "hc_post · mlp", "sublabel": "post·x + residual · 无参数", "stage": 2, "row": 0, "width": 180 },
