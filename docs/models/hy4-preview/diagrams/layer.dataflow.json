      { "id": "ihc-boundary", "label": "iHC 边界", "focus": ["layer-input", "hc-pre-a", "hc-post-a", "hc-pre-m", "hc-post-m", "layer-out"], "note": "pre 有参数(hc_fn + σ 门),post 无参数(post·x + residual)。" },
      { "id": "subblocks", "label": "两个子块", "focus": ["attn-sub", "ffn-sub"], "note": "注意力子块见 dsa-indexer / dsa-mla 图;FFN 子块见 moe 图。" }
